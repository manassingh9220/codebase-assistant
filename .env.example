# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/codebase_assistant

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Voyage AI (Embeddings)
VOYAGE_API_KEY=your_voyage_key_here

